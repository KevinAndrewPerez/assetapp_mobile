# NUTrace web app: serves Laravel /storage files. Its forgot-password form is only a
# fallback for builds with no mail key — see BUILD_APP.md (forgot password).
EXPO_PUBLIC_WEB_URL=https://nutrace-production.up.railway.app

# Email service that mails the reset code (see BUILD_APP.md). Without a key the app
# falls back to the website form, which never delivers on the current deployment.
# resend.com = simplest, delivers to your own address only until a domain is verified.
# brevo.com  = verify one sender address instead, then any registered user can be mailed.
# EXPO_PUBLIC_MAIL_API_KEY=
# EXPO_PUBLIC_MAIL_PROVIDER=resend
# EXPO_PUBLIC_MAIL_FROM=onboarding@resend.dev
